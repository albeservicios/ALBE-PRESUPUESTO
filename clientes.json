function cargarSucursales(){

let clienteSeleccionado="";

if(document.getElementById("btnOncity").classList.contains("activo")){
    clienteSeleccionado="ON CITY";
}


let sucursal=document.getElementById("sucursal");

sucursal.innerHTML =
"<option>Seleccione...</option>";


let provincia =
document.getElementById("provincia").value;


let localidad =
document.getElementById("localidad").value;



(datosClientes[clienteSeleccionado] || [])
.forEach(function(item){


if(item.provincia==provincia &&
item.localidad==localidad){


let op=document.createElement("option");

op.value=item.sucursal;

op.textContent=item.sucursal;


sucursal.appendChild(op);


}


});


},

