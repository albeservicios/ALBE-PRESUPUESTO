*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#f2f2f2;
padding:20px;
}

header{
background:#0057A8;
color:#fff;
padding:20px;
text-align:center;
border-radius:10px;
margin-bottom:20px;
}

.container{
max-width:900px;
margin:auto;
background:#fff;
padding:20px;
border-radius:10px;
box-shadow:0 0 10px rgba(0,0,0,.15);
}

h2{
margin-top:20px;
margin-bottom:10px;
color:#0057A8;
}

label{
display:block;
margin-top:15px;
font-weight:bold;
}

input,
textarea{
width:100%;
padding:10px;
margin-top:5px;
border:1px solid #ccc;
border-radius:5px;
font-size:15px;
}

textarea{
height:120px;
resize:vertical;
}

table{
width:100%;
border-collapse:collapse;
margin-top:15px;
}

th{
background:#0057A8;
color:#fff;
padding:10px;
}

td{
border:1px solid #ddd;
padding:8px;
}

button{
width:100%;
padding:14px;
margin-top:15px;
background:#0057A8;
color:white;
border:none;
border-radius:6px;
font-size:16px;
cursor:pointer;
}

button:hover{
background:#003f7a;
}

