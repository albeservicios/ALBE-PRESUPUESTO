<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ALBE Presupuestos</title>

<link rel="stylesheet" href="style.css">

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

</head>

<body>

<header>
<h1>ALBE SERVICIOS GENERALES</h1>
<p>Sistema de Presupuestos</p>
</header>

<div class="container">

<h2>Datos del Cliente</h2>

<label>N° Agenda</label>
<input type="text" id="agenda">

<label>Fecha</label>
<input type="date" id="fecha">

<label>Cliente</label>
<input type="text" id="cliente">

<label>Sucursal</label>
<input type="text" id="sucursal">

<label>Provincia</label>
<input type="text" id="provincia">

<label>Localidad</label>
<input type="text" id="localidad">

<label>Lugar del Servicio</label>
<input type="text" id="lugar">

<label>Tareas a realizar</label>
<textarea id="tareas"></textarea>

<h2>Materiales</h2>

<table>
<thead>
<tr>
<th>Material</th>
<th>Cantidad</th>
<th>Precio</th>
<th>Subtotal</th>
<th></th>
</tr>
</thead>

<tbody id="cuerpoMateriales">
</tbody>
</table>

<button type="button" id="btnAgregar">
➕ Agregar Material
</button>

<input type="hidden" id="materiales" value="0">

<h2>Costos</h2>

<label>Mano de Obra</label>
<input type="number" id="mano" value="0">

<label>Viáticos</label>
<input type="number" id="viaticos" value="0">

<label>Flete</label>
<input type="number" id="flete" value="0">

<div class="total">
TOTAL: $<span id="total">0</span>
</div>

<button type="button" id="btnCalcular">
💰 Calcular
</button>

<button type="button" id="btnWhatsApp">
📲 Compartir por WhatsApp
</button>

<button type="button" id="btnPDF">
📄 Generar PDF
</button>

</div>

<script src="script.js"></script>

</body>
</html>
